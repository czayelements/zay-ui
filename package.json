{
  "name": "zay-ui-monorepo",
  "private": true,
  "description": "zay-ui: a calm, tonal design system built on Base UI. The npm package lives in packages/zay-ui, the documentation site in docs/.",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm --filter @czayelements/zay-ui build",
    "typecheck": "pnpm --filter @czayelements/zay-ui typecheck && pnpm --filter zay-ui-docs typecheck",
    "dev:docs": "pnpm --filter zay-ui-docs dev",
    "build:docs": "pnpm --filter @czayelements/zay-ui build && pnpm --filter zay-ui-docs build:pages"
  }
}
