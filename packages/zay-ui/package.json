{
  "name": "@czayelements/zay-ui",
  "version": "0.1.0-alpha.3",
  "description": "Accessible React components and ready-made blocks on Base UI, themable with one CSS variable. Works with or without Tailwind CSS v4.",
  "keywords": [
    "react",
    "ui",
    "components",
    "blocks",
    "design-system",
    "base-ui",
    "tailwindcss",
    "accessible",
    "dark-mode",
    "nextjs"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "import": "./dist/blocks/index.js",
      "default": "./dist/blocks/index.js"
    },
    "./styles.css": "./styles/index.css",
    "./tokens.css": "./styles/tokens.css",
    "./tailwind.css": "./styles/tailwind.css",
    "./base.css": "./styles/base.css",
    "./components.css": "./styles/components.css",
    "./blocks.css": "./styles/blocks.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5"
  },
  "license": "MIT",
  "author": "Furkan Özay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czayelements/zay-ui.git",
    "directory": "packages/zay-ui"
  },
  "homepage": "https://github.com/czayelements/zay-ui#readme",
  "bugs": "https://github.com/czayelements/zay-ui/issues",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
